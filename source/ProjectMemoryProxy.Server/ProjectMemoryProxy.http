@HostAddress = http://localhost:6186

POST {{HostAddress}}/
Accept: application/json, text/event-stream
Content-Type: application/json
MCP-Protocol-Version: 2025-11-25

{
    "jsonrpc": "2.0",
    "id": 1,
    "method": "tools/call",
    "params": {
        "name": "resolve_context",
        "arguments": {
            "context_id": "git:github.com/ChrSchu90/ProjectMemoryProxy"
        }
    }
}
